# Banco (docker compose)
DB_NAME=ritmo
DB_USER=ritmo
DB_PASSWORD=ritmo
DB_PORT=5433

# Backend (backend/.env quando rodar fora do Docker)
# AMBIENTE: dev | teste | producao. Em `producao` o boot FALHA se: JWT_SEGREDO for o default ou
# tiver < 32 chars, as chaves VAPID forem as de dev, COOKIE_SEGURO=false ou CORS tiver localhost.
AMBIENTE=dev
DATABASE_URL=postgresql+asyncpg://ritmo:ritmo@localhost:5433/ritmo
CORS_ORIGENS=["http://localhost:3000"]
SQL_ECHO=false
# /docs, /redoc e /openapi.json (desligue em produção)
DOCS_HABILITADO=true
# Segredo de dev PÚBLICO (está no repositório). Em produção gere um próprio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=segredo-dev-inseguro-trocar-em-producao-32b
ACCESS_TOKEN_EXPIRA_MIN=15
REFRESH_TOKEN_EXPIRA_DIAS=30
COOKIE_SEGURO=false
# lax | strict | none (none exige COOKIE_SEGURO=true; use se front e API estiverem em sites distintos)
COOKIE_SAMESITE=lax
REGISTRO_ABERTO=true
# Rate limit em memória em /auth (login 10/min, registrar 5/min, refresh 30/min por IP).
# Vazio = ligado, exceto em AMBIENTE=teste. Atrás de proxy, o IP vem de --proxy-headers.
# RATE_LIMIT_ATIVO=true

# Web Push / VAPID. Os defaults do código são chaves de dev PÚBLICAS; em produção gere um par:
#   cd backend && uv run python -c "import base64; from py_vapid import Vapid; from cryptography.hazmat.primitives import serialization as s; v=Vapid(); v.generate_keys(); b=lambda x: base64.urlsafe_b64encode(x).rstrip(b'=').decode(); print('VAPID_PRIVATE_KEY='+b(v.private_key.private_numbers().private_value.to_bytes(32,'big'))); print('VAPID_PUBLIC_KEY='+b(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint)))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_EMAIL=mailto:voce@seudominio.com
# Loop de lembretes dentro da API (dev). Em produção: DESPACHADOR_ATIVO=false na API e
# um processo separado com `python -m app.worker` (serviço `worker` do docker-compose.prod.yml).
DESPACHADOR_ATIVO=true

# Produção (docker-compose.prod.yml): além das variáveis acima, defina
#   API_URL_PUBLICA=https://api.seudominio.com   (embutida no build do frontend)
#   API_PORTA=8000  FRONTEND_PORTA=8080

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000
